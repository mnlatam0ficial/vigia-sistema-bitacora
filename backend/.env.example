# Copia este archivo a ".env" y ajusta los valores.

# SQLite local (por defecto — no requiere configuración):
# DATABASE_URL=sqlite:///./bitacora.db

# Postgres vía Supabase en producción (Project Settings -> Database -> Connection string):
# DATABASE_URL=postgresql://postgres:TU-PASSWORD@TU-HOST.supabase.co:5432/postgres

# Clave para proteger el endpoint de administración de la suscripción.
# Cámbiala antes de desplegar a producción.
ADMIN_API_KEY=cambia-esta-clave-en-produccion
